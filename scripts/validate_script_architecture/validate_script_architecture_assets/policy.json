{
  "preferred_atomic_lines": 25,
  "maximum_atomic_lines": 40,
  "maximum_python_file_lines": 200,
  "large_dictionary_entries": 9,
  "manager_filename": "<tool_name>.py",
  "workers_directory": "<tool_name>_workers",
  "assets_directory": "<tool_name>_assets",
  "settings_authority": ".caprmedio/settings.toml",
  "manager_forbidden_imports": [
    "argparse",
    "json",
    "multiprocessing",
    "shutil",
    "subprocess",
    "tempfile",
    "tomllib"
  ],
  "manager_forbidden_calls": [
    "input",
    "open",
    "print",
    "mkdir",
    "read_bytes",
    "read_text",
    "rename",
    "replace",
    "rmdir",
    "touch",
    "unlink",
    "write_bytes",
    "write_text"
  ]
}
